{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BryanLimak/simulando-prova-skill/schema/prova.schema.json",
  "title": "Prova (simulando-prova/v1)",
  "description": "Uma prova (agrupador) com um ou mais simulados de questões de múltipla escolha.",
  "type": "object",
  "required": ["format", "simulados"],
  "additionalProperties": false,
  "properties": {
    "format": { "enum": ["simulando-prova/v1", "classificados-prova/v1"] },
    "exported_at": { "type": "string" },
    "prova": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "description": { "type": ["string", "null"], "maxLength": 3000 },
        "category": {
          "type": ["string", "null"],
          "enum": ["tecnologia", "programacao", "certificacoes", "idiomas", "concursos", "vestibular", "escolar", "negocios", "saude", "direito", "exatas", "humanas", "ciencias", "outros", null]
        },
        "icon": { "type": ["string", "null"], "maxLength": 4 }
      }
    },
    "simulados": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/simulado" }
    }
  },
  "$defs": {
    "simulado": {
      "type": "object",
      "required": ["questions"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "description": { "type": ["string", "null"], "maxLength": 3000 },
        "pass_score": { "type": "integer", "minimum": 1, "maximum": 100 },
        "time_limit_min": { "type": ["integer", "null"], "minimum": 1, "maximum": 600 },
        "questions": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/question" } }
      }
    },
    "question": {
      "type": "object",
      "required": ["text", "alternatives"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "explanation": { "type": ["string", "null"], "maxLength": 20000 },
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/alternative" },
          "contains": { "type": "object", "properties": { "is_correct": { "const": true } }, "required": ["is_correct"] }
        }
      }
    },
    "alternative": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "is_correct": { "type": "boolean" }
      }
    }
  }
}
